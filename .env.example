DATABASE_URL=mysql://root:password@localhost:3306/smartpocket
JWT_SECRET=replace-with-a-long-random-secret

# Server-only: 32-byte AES key for encrypting card numbers at rest (hex or base64).
# Generate: openssl rand -hex 32
CARD_ENCRYPTION_KEY=

# Optional OAuth settings. Local development can use POST /api/dev/login.
VITE_APP_ID=dev-local-app
OAUTH_SERVER_URL=

# Client API URL.
# - Web / iOS Simulator: http://localhost:3000 is fine when the API runs locally.
# - Physical device / Android emulator: leave unset for auto-detect from Metro,
#   or set to your machine's LAN IP (e.g. http://192.168.1.5:3000).
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_API_PORT=3000
