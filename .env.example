# SmartPocket environment configuration.
#
# Copy to `.env` and fill in. Anything prefixed `EXPO_PUBLIC_` is inlined into
# the client bundle at build time and is therefore PUBLIC — never put a secret
# behind that prefix.
#
# Vars marked [prod-required] fail CLOSED when unset: the server keeps running
# but the dependent feature is off. Check them all before a production deploy.

# ─────────────────────────────────────────────────────────────────────────────
# Server — core
# ─────────────────────────────────────────────────────────────────────────────

# Port the API listens on (default 3000).
PORT=3000

# Leave unset to run against the seeded in-memory dev database (server/_core/devDb.ts).
# No MySQL needed for local work or QA.
#
# Under docker-compose the host is `host.docker.internal`, never `localhost` —
# inside the API container localhost is the API container itself. The compose
# file maps that name to the host gateway, and MySQL is reached through its
# published host port.
DATABASE_URL=mysql://root:password@localhost:3306/smartpocket

# Signs session JWTs. Must be >= 32 characters.
# Production REFUSES TO BOOT without it; dev falls back to a committed,
# insecure secret and warns loudly.
# Generate: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Server-only: 32-byte AES key encrypting card numbers at rest (hex or base64).
# Changing this makes every previously stored card number undecryptable.
# Generate: openssl rand -hex 32
CARD_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Native builds  [prod-required]
# ─────────────────────────────────────────────────────────────────────────────

# Gates Android cleartext HTTP. Anything other than exactly "production"
# builds the APK with `usesCleartextTraffic: true` (app.config.ts), so a
# release built without this set allows plain http:// traffic. Set it for
# every production `expo run:android` / EAS build.
APP_ENV=

# ─────────────────────────────────────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────────────────────────────────────
#
# Accounts are email + password, held in this database — there is no external
# identity provider to configure, and nothing here to set. Sessions are the
# HS256 JWTs signed with JWT_SECRET above, so rotating that secret signs
# everyone out. See server/_core/auth-routes.ts.

# ─────────────────────────────────────────────────────────────────────────────
# Server — cross-origin access  [prod-required]
# ─────────────────────────────────────────────────────────────────────────────

# Comma-separated origins allowed to make credentialed requests to the API.
# The API previously reflected ANY Origin back with `Allow-Credentials: true`,
# which let any third-party page read a signed-in user's data (QA SP-005).
#
# Localhost origins are added automatically OUTSIDE production only. In
# production an empty allowlist blocks every cross-origin request — so if the
# web client is served from a different origin than the API, the app is dead
# in the water until this is set. The server now refuses to boot in production
# when it is empty.
#
# Only needed when client and API are on different origins.
ALLOWED_ORIGINS=https://app.example.com,https://www.example.com

# ─────────────────────────────────────────────────────────────────────────────
# Server — scheduled jobs  [prod-required]
# ─────────────────────────────────────────────────────────────────────────────

# Bearer secret authorising POST /api/scheduled/generate-recurring, which
# generates due recurring transactions for all users. It used to be completely
# unauthenticated (QA SP-011).
#
# When unset, the endpoint only accepts the platform's cron identity. Off that
# platform nothing can ever authorise it, so recurring transactions silently
# stop generating — no error, no log. Set it and have your scheduler send
# `Authorization: Bearer <value>`.
# Generate: openssl rand -hex 32
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Docker deployment (docker-compose.yml only — the server itself ignores these)
# ─────────────────────────────────────────────────────────────────────────────

# Host port the API is published on, bound to 127.0.0.1 for the reverse proxy.
# Inside the container the port is always 3000 regardless of PORT above.
API_PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# Client — API location
# ─────────────────────────────────────────────────────────────────────────────

# - Web / iOS Simulator: http://localhost:3000 when the API runs locally.
# - Physical device / Android emulator: leave unset to auto-detect from Metro,
#   or set your machine's LAN IP (e.g. http://192.168.1.5:3000).
# - Plain localhost web cannot derive the API host via the 8081->3000 port
#   swap, so set this explicitly when running the web client locally.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_API_PORT=3000

# Dev web builds sign themselves in automatically against /api/dev/login, which
# makes the login and signup screens unreachable while you are working on them.
# Set to 0 to get the signed-out app. No effect in a production build.
# EXPO_PUBLIC_DEV_AUTOLOGIN=0
