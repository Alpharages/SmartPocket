DATABASE_URL=mysql://root:password@localhost:3306/smartpocket
JWT_SECRET=replace-with-a-long-random-secret

# Optional OAuth settings. Local development can use POST /api/dev/login.
VITE_APP_ID=dev-local-app
OAUTH_SERVER_URL=

# Client API URL. Native dev can also derive this from Metro host + EXPO_PUBLIC_API_PORT.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_API_PORT=3000
